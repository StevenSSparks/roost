{
  "name": "FriendlyPortal",
  "hostname": "friendlyportal",
  "prompt": "friendlyportal# ",
  "ssid": "WiFi Fun",
  "domain": "wififun.net",
  "dnsAnswer": "127.0.0.1",
  "extendedShell": true,
  "motd": "Welcome to FriendlyPortal \u2014 a RoostOS demo. Play, browse, and it's all offline.",
  "services": {
    "http": {
      "enabled": true,
      "addr": ":8080"
    },
    "https": {
      "enabled": true,
      "addr": ":8443",
      "certDir": "data/certs"
    },
    "dns": {
      "enabled": true,
      "addr": ":5354"
    },
    "ssh": {
      "enabled": true,
      "addr": ":2222",
      "user": "friendly",
      "pass": "friendly"
    },
    "dashboard": {
      "enabled": true,
      "addr": ":9090"
    }
  }
}
